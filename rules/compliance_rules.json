{
  "metadata": {
    "rule_set": "Compliance Rules",
    "version": "1.0.0",
    "organization": "Demo Configuration",
    "environment": "Hackathon",
    "last_updated": "2026-07-24",
    "author": "SentinelAI Team"
  },
  "rules": [
    {
      "rule_id": "CMP-001",
      "name": "KYC Verification",
      "enabled": true,
      "priority": 1,
      "action": "credit_limit_increase",
      "conditions": {
        "kyc_verified": false
      },
      "decision": "block",
      "confidence": 1.0,
      "severity": "critical",
      "reason": "Customer must complete KYC verification."
    },
    {
      "rule_id": "CMP-002",
      "name": "AML Review",
      "enabled": true,
      "priority": 2,
      "action": "merchant_payment",
      "conditions": {
        "aml_flag": true
      },
      "decision": "review",
      "confidence": 0.98,
      "severity": "high",
      "reason": "AML monitoring flag detected."
    }
  ]
}