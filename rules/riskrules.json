{
  "metadata": {
    "rule_set": "Risk Rules",
    "version": "1.0.0",
    "organization": "Demo Configuration",
    "environment": "Hackathon",
    "last_updated": "2026-07-24",
    "author": "SentinelAI Team"
  },
  "rules": [
    {
      "rule_id": "RSK-001",
      "name": "High Value Request",
      "enabled": true,
      "priority": 1,
      "action": "refund",
      "conditions": {
        "min_amount": 75000
      },
      "decision": "review",
      "confidence": 0.92,
      "severity": "high",
      "reason": "High-value financial request detected."
    },
    {
      "rule_id": "RSK-002",
      "name": "Critical Amount",
      "enabled": true,
      "priority": 2,
      "action": "merchant_payment",
      "conditions": {
        "min_amount": 500000
      },
      "decision": "block",
      "confidence": 0.99,
      "severity": "critical",
      "reason": "Transaction exceeds acceptable organizational risk."
    }
  ]
}